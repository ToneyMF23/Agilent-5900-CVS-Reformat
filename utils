#  SMART FILENAME SUGGESTION
# ════════════════════════════════════════════════════════════════════════════

def suggest_filename(df_raw: pd.DataFrame) -> str:
    """
    Build a meaningful suggested output filename from the sample labels.

    Pattern:  {ExperimentCode}-{TU?}_Cleaned_Usable_Data.xlsx

    How the experiment code is found:
      Scans Sample-type labels for the pattern  WORD-digit
      e.g. "BOZ-1 Yield 1"  →  code = "BOZ"
           "POZO-2 Reject"  →  code = "POZO"
           "Egypt-234-1 X"  →  code = "Egypt-234"

    TU flag:
      Added as "-TU" if any sample label contains the text "TU"
      e.g. "TU Water" triggers it.

    Falls back to "Cleaned_Usable_Data.xlsx" if nothing matches.
    """
    samples = (df_raw[df_raw["Type"] == "Sample"]["Label"]
               .dropna().unique().tolist()
               if "Type" in df_raw.columns else [])

    exp_code = ""
    for lbl in samples:
        m = re.match(r'^([A-Za-z][A-Za-z0-9\-]*?)-(\d+)\b', str(lbl))
        if m:
            exp_code = m.group(1).rstrip("-")
            break

    has_tu = any("TU" in str(lbl).upper() for lbl in samples)

    if exp_code:
        stem = exp_code + ("-TU" if has_tu else "") + "_Cleaned_Usable_Data"
    else:
        stem = "Cleaned_Usable_Data"

    return stem + ".xlsx"


