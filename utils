def open_path(path: str):
    """Open a file or folder in the OS default viewer / file manager."""
    try:
        if _OS == "Windows":
            os.startfile(path)
        elif _OS == "Darwin":
            subprocess.Popen(["open", path])
        else:
            subprocess.Popen(["xdg-open", path])
    except Exception:
        pass


