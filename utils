# ════════════════════════════════════════════════════════════════════════════
#  CONFIG
# ════════════════════════════════════════════════════════════════════════════

def load_config():
    """Load saved settings. Falls back to defaults if file missing/corrupt."""
    cfg = dict(CFG_DEFAULTS)
    try:
        with open(CONFIG_PATH, encoding="utf-8") as f:
            cfg.update(json.load(f))
    except Exception:
        pass
    return cfg


def save_config(cfg):
    """Write settings to disk. Silently ignores write errors."""
    try:
        with open(CONFIG_PATH, "w", encoding="utf-8") as f:
            json.dump(cfg, f, indent=2)
    except Exception:
        pass


# ════════════════════════════════════════════════════════════════════════════
#  ERROR LOGGING
# ════════════════════════════════════════════════════════════════════════════

def log_error(context: str, exc: Exception) -> str:
    """
    Write a full Python traceback to the error log file.
    Returns a short, user-friendly string for display in the GUI.
    The user never sees a raw traceback — it stays in the log file.
    """
    ts  = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    tb  = traceback.format_exc()
    msg = f"\n[{ts}] {context}\n{tb}\n{'─'*60}\n"
    try:
        with open(ERROR_LOG, "a", encoding="utf-8") as f:
            f.write(msg)
    except Exception:
        pass
    return (f"{context}: {type(exc).__name__} — {exc}\n"
            f"(Full details saved to icp_cleaner_error.log)")


