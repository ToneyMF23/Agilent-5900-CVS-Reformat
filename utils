#  CONVERSION HISTORY LOG
# ════════════════════════════════════════════════════════════════════════════

def log_conversion(input_path: str, output_path: str,
                   n_samples: int, n_elements: int,
                   pdf_path: str = "", success: bool = True,
                   note: str = ""):
    """
    Append one record to the persistent conversion log (JSON Lines format).
    Each line is a self-contained JSON object — easy to parse, easy to read.

    Fields written:
        timestamp    — ISO datetime of the conversion
        status       — "ok" or "failed"
        input_file   — basename of the source ICP file
        input_path   — full path
        output_file  — basename of the Excel output
        output_path  — full path
        pdf_file     — basename of the PDF (empty string if not generated)
        samples      — number of sample rows processed
        elements     — number of element columns
        note         — any free-text note (e.g. re-run handling used)
    """
    record = {
        "timestamp":   datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
        "status":      "ok" if success else "failed",
        "input_file":  os.path.basename(input_path),
        "input_path":  input_path,
        "output_file": os.path.basename(output_path),
        "output_path": output_path,
        "pdf_file":    os.path.basename(pdf_path) if pdf_path else "",
        "samples":     n_samples,
        "elements":    n_elements,
        "note":        note,
    }
    try:
        with open(CONV_LOG, "a", encoding="utf-8") as f:
            f.write(json.dumps(record) + "\n")
    except Exception:
        pass


def load_conversion_log() -> list:
    """
    Return all conversion records as a list of dicts, newest first.
    Returns empty list if the log doesn't exist yet.
    """
    records = []
    try:
        with open(CONV_LOG, encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if line:
                    try:
                        records.append(json.loads(line))
                    except json.JSONDecodeError:
                        pass
    except FileNotFoundError:
        pass
    return list(reversed(records))


