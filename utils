#  AGILENT FILE LOADING
# ════════════════════════════════════════════════════════════════════════════

def load_agilent_file(path: str) -> pd.DataFrame:
    """
    Load an Agilent ICP export file (CSV or Excel).

    Agilent puts 6 lines of metadata at the top of every export before the
    real column headers start — this function skips those automatically.
    All values are loaded as strings so nothing gets silently converted.
    Trailing/leading whitespace is stripped from every text cell.
    """
    ext = path.lower().rsplit(".", 1)[-1]
    kw  = dict(skiprows=6, header=0, dtype=str)

    if ext == "csv":
        df = pd.read_csv(path, **kw)
    elif ext in ("xlsx", "xlsm"):
        df = pd.read_excel(path, engine="openpyxl", **kw)
    elif ext == "xls":
        try:
            df = pd.read_excel(path, engine="xlrd", **kw)
        except Exception:
            df = pd.read_excel(path, engine="openpyxl", **kw)
    else:
        # Unknown extension — try CSV first, then Excel
        try:
            df = pd.read_csv(path, **kw)
        except Exception:
            df = pd.read_excel(path, **kw)

    # Strip invisible whitespace from every text cell
    return df.apply(lambda c: c.str.strip() if c.dtype == object else c)


# ════════════════════════════════════════════════════════════════════════════
#  UNIT CONVERSION + VALUE CLEANING
# ════════════════════════════════════════════════════════════════════════════

# Multiply by this factor to convert any unit → ppm (mg/L)
_UNIT_TO_PPM = {
    "ppm":   1.0,  "mg/l":  1.0,  "mg/kg": 1.0,
    "ppb":   1e-3, "ug/l":  1e-3, "ug/kg": 1e-3,
    "ppt":   1e-6, "ng/l":  1e-6,
    "ratio": None,   # dimensionless — skip conversion
}

# Strings that mean "this measurement was outside the calibration range"
_UNCAL_MARKERS = {"uncal", "-", "nan", "none", ""}


def _is_uncal(val) -> bool:
    return (str(val).strip().lower() in _UNCAL_MARKERS or
            (not isinstance(val, str) and pd.isna(val)))


def _to_float(s):
    try:
        return float(s)
    except (ValueError, TypeError):
        return None


def clean_value(val, uncal_mode: str,
                from_unit: str = None,
                target_unit: str = "Keep as-is"):
    """
    Convert one raw concentration cell to its final clean value.

    Steps in order:
      1. If the value is an Uncal marker → return per uncal_mode setting
      2. If unit conversion is requested → convert to target unit
      3. Cast to float if possible, otherwise leave as text
    """
    s = str(val).strip()

    if _is_uncal(s):
        return {
            "keep_text": "Uncal",
            "blank":     None,
            "zero":      0,
        }.get(uncal_mode, "Uncal")

    fu     = (from_unit or "").strip().lower()
    factor = _UNIT_TO_PPM.get(fu)
    num    = _to_float(s)

    if num is not None and factor is not None and target_unit != "Keep as-is":
        ppm = num * factor
        return (round(ppm * 1000, 6) if target_unit == "ppb (ug/L)"
                else round(ppm, 6))

    return num if num is not None else s


def safe_avg(series):
    """
    Average the numeric values in a pandas Series.
    Non-numeric items (like "Uncal") are collected separately;
    if there are no numbers at all, return the first non-numeric value.
    This way re-run averaging never crashes on mixed-type columns.
    """
    nums, text = [], []
    for v in series:
        if v is None or (isinstance(v, float) and pd.isna(v)):
            continue
        n = _to_float(v)
        if n is not None:
            nums.append(n)
        else:
            text.append(v)
    if nums:
        return round(sum(nums) / len(nums), 6)
    return text[0] if text else None
